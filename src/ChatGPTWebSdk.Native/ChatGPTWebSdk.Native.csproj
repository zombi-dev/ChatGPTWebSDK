<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>ChatGPTWebSdk.Native</PackageId>
    <Description>ChatGPT web, Codex OAuth and official API backends for the unmodified official OpenAI .NET SDK.</Description>
    <DefineConstants>$(DefineConstants);CHATGPTWEB_NATIVE</DefineConstants>
    <NoWarn>$(NoWarn);OPENAI001;OPENAI002;SCME0001;SCME0002</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ChatGPTWebSdk/ChatGPTWebSdk.csproj" />
    <ProjectReference Include="../ChatGPTWebSdk.Browser/ChatGPTWebSdk.Browser.csproj" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <!-- OpenAI 2.14 public signatures reference streaming types removed in ClientModel 1.16. -->
    <PackageReference Include="System.ClientModel" Version="[1.15.0,1.16.0)" />
    <Compile Include="../ChatGPTWebSdk.OpenAI/ChatGPTWeb.cs" Link="ChatGPTWeb.cs" />
    <Compile Include="../ChatGPTWebSdk.OpenAI/ChatGPTCodex.cs" Link="ChatGPTCodex.cs" />
    <Compile Include="../ChatGPTWebSdk.OpenAI/ChatGPTOfficial.cs" Link="ChatGPTOfficial.cs" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/NATIVE_SDK.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
