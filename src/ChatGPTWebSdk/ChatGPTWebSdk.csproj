<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>ChatGPTWebSdk</PackageId>
    <Description>ChatGPT web HTTP conversation and asset SDK with an OpenAPI operation client.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Generated/openapi-operations.json" />
    <EmbeddedResource Include="Generated/web-operations.json" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
