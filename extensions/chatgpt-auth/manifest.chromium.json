{
  "manifest_version": 3,
  "name": "ChatGPT Web SDK Auth",
  "version": "1.5.1",
  "description": "Click on your signed-in ChatGPT tab to copy one authentication string for the C# ChatGPT Web SDK.",
  "minimum_chrome_version": "119",
  "permissions": ["activeTab", "scripting", "cookies", "clipboardWrite"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Copy ChatGPT SDK authentication", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
